{
  "name": "eurovision-backend",
  "version": "0.0.1",
  "description": "backend for eurovision app",
  "scripts": {
    "watch": "tsc --watch --preserveWatchOutput --pretty",
    "dev": "cross-env NODE_ENV=development nodemon",
    "tsx": "tsx src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js"
  },
  "author": "Anna L.",
  "license": "MIT",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.2.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.8.5",
    "fastify-autoload": "^3.13.0",
    "fastify-plugin": "^5.1.0",
    "fluent-json-schema": "^6.0.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.14.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/shortid": "^2.2.0",
    "cross-env": "^7.0.1",
    "fastify-tsconfig": "^3.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.0",
    "rimraf": "^6.1.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
